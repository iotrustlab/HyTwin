/* Reconstructed from HyTwin (NFM 2025), Example 1, pp. 7-8.
   Not recovered original source. See docs/formal-models.md for corrections,
   assumptions, and verification status. The loop invariant and proof tactic below are newly reconstructed. */
ArchiveEntry "HyTwin/Reconstructed nominal two-tank safety"
Definitions
  Real LL;
  Real HH;
  Real L1;
  Real H1;
  Real L2;
  Real H2;
  Real F1;
  Real F2;
  Real eps;

  HP sense ::= {
    xhat1 := x1;
    xhat2 := x2;
    f1 := *;
    f2 := *;
    ?(0 <= f1 & f1 <= F1 & 0 <= f2 & f2 <= F2);
  };

  HP inflow ::= {
    if (f1 > (HH - xhat1)/eps) { v1 := 0; }
    else {
      if (xhat1 <= L1) { v1 := 1; }
      else { ?true; }
    }
  };

  HP outflow ::= {
    if (xhat2 <= L2) { p2 := 1; v2 := 1; }
    else { ?true; }
  };

  HP protect ::= {
    if (v1*f1-v2*p2*f2 < (LL-xhat1)/eps |
        v2*p2*f2 > (HH-xhat2)/eps) {
      p2 := 0;
      v2 := 0;
    } else { ?true; }
  };

  HP ctrl ::= { inflow; outflow; protect; };

  HP plant ::= {
    { x1' = v1*f1-v2*p2*f2,
      x2' = v2*p2*f2,
      t' = 1 & x1 >= 0 & x2 >= 0 & t <= eps }
  };

  HP tank ::= { sense; ctrl; t := 0; plant; };
End.

ProgramVariables
  Real x1;
  Real x2;
  Real xhat1;
  Real xhat2;
  Real f1;
  Real f2;
  Real v1;
  Real v2;
  Real p2;
  Real t;
End.

Problem
  eps > 0 & 0 <= LL & 0 <= F1 & 0 <= F2 &
  LL < L1 & L1 <= x1 & x1 <= H1 & H1 < HH &
  LL < L2 & L2 <= x2 & x2 <= H2 & H2 < HH &
  v1 = 0 & v2 = 0 & p2 = 0
  -> [{tank;}*](LL <= x1 & x1 <= HH & LL <= x2 & x2 <= HH)
End.
Tactic "Reconstructed loop invariant proof"
  expandAllDefs; loop("eps()>0 & 0<=LL() & 0<=F1() & 0<=F2() & LL()<=x1 & x1<=HH() & LL()<=x2 & x2<=HH() & (v1=0 | v1=1) & (v2=0 | v2=1) & (p2=0 | p2=1)",1); <(auto, auto, auto)
End.
End.
