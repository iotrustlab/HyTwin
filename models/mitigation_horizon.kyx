/* Reconstructed fixed-flow specialization of HyTwin Example 5.
   Single tank, constant positive level rate q, no outflow, immediate final
   shutoff, unbounded clock c. Distinct from the full nondeterministic model. */

ArchiveEntry "HyTwin/Fixed-flow horizon preserves safety"
ProgramVariables
  Real x;
  Real x0;
  Real LL;
  Real HH;
  Real q;
  Real c;
  Real tau;
End.
Problem
  0 <= LL & LL <= x & x = x0 & x0 <= HH & q > 0 &
  tau = (HH-x0)/q
  -> [c := 0; {x' = q, c' = 1 & c <= tau}](LL <= x & x <= HH)
End.
Tactic "Reconstructed proof"
  auto
End.
End.

ArchiveEntry "HyTwin/Fixed-flow horizon is maximal"
ProgramVariables
  Real x0;
  Real HH;
  Real q;
  Real tau;
  Real later;
End.
Problem
  x0 <= HH & q > 0 & tau = (HH-x0)/q & later > tau
  -> x0+q*later > HH
End.
Tactic "Reconstructed proof"
  QE
End.
End.

ArchiveEntry "HyTwin/On-time shutdown preserves the tank level"
ProgramVariables
  Real x;
  Real x0;
  Real LL;
  Real HH;
  Real q;
  Real u;
  Real c;
  Real tau;
End.
Problem
  0 <= LL & LL <= x & x = x0 & x0 <= HH & q > 0 &
  tau = (HH-x0)/q
  -> [u := 1; c := 0;
      {x' = u*q, c' = 1 & c <= tau};
      u := 0;
      {x' = u*q, c' = 1 & true}](LL <= x & x <= HH)
End.
Tactic "Reconstructed proof"
  auto
End.
End.
